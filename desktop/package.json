{
  "name": "erselmetz-ai-desktop",
  "version": "0.1.0",
  "private": true,
  "author": "ERSELMETZ AI",
  "description": "Local Electron desktop shell for ERSELMETZ AI",
  "main": "main.cjs",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "ui:install": "npm --prefix ../desktop-ui ci",
    "ui:build": "npm --prefix ../desktop-ui run build",
    "backend:build": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-backend.ps1",
    "start": "electron .",
    "dist:win": "npm run ui:build && npm run backend:build && powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-installer.ps1",
    "test": "node --test"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.erselmetz.ai.commandcenter",
    "productName": "ERSELMETZ AI",
    "asar": true,
    "files": ["main.cjs", "screen-capture.cjs", "ollama-installer.cjs", "local-diagnostics.cjs", "local-reset.cjs", "preload.cjs", "bootstrap.html", "bootstrap.css", "bootstrap.js", "package.json"],
    "extraResources": [
      { "from": "build/backend/erselmetz-backend", "to": "backend", "filter": ["**/*"] },
      { "from": "../desktop-ui/out", "to": "desktop-ui", "filter": ["**/*"] }
    ],
    "directories": { "output": "release" },
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "artifactName": "ERSELMETZ-AI-Setup-${version}-win-x64.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "include": "scripts/uninstaller.nsh",
      "oneClick": false,
      "perMachine": false,
      "packElevateHelper": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": false
    }
  }
}
